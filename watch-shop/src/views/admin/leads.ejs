<%- include('../partials/head') %>
<%- include('_nav') %>
<h1 class="page-title">Заявки</h1>
<p class="muted">Сообщения и заказы звонка с сайта.</p>

<nav class="tabs" aria-label="Фильтр по статусу">
  <a href="/admin/leads" <%- !status ? 'aria-current="page"' : '' %>>Все</a>
  <% Object.entries(fmt.LEAD_STATUSES).forEach(([key, label]) => { %>
    <a href="/admin/leads?status=<%= key %>" <%- status === key ? 'aria-current="page"' : '' %>><%= label %> <span class="count"><%= counts[key] %></span></a>
  <% }) %>
</nav>

<% if (list.length === 0) { %>
  <div class="empty"><p class="empty-title">Заявок пока нет</p><p class="muted">Они появятся здесь, когда посетители отправят форму на странице «Контакты».</p></div>
<% } else { %>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Дата</th><th>Тип</th><th>Имя</th><th>Телефон</th><th>Сообщение</th><th>Статус</th></tr></thead>
  <tbody>
    <% list.forEach((l) => { %>
    <tr>
      <td><a href="/admin/leads/<%= l.id %>"><%= dateTime(l.created_at) %></a></td>
      <td><%= fmt.LEAD_KINDS[l.kind] %></td>
      <td><%= l.name %></td>
      <td><a href="tel:<%= (toTel(l.phone) || l.phone) %>"><%= l.phone %></a></td>
      <td class="cell-wrap"><%= l.message.length > 70 ? l.message.slice(0, 70) + '…' : l.message %></td>
      <td><span class="status status-lead-<%= l.status %>"><%= fmt.LEAD_STATUSES[l.status] %></span></td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>
<%- include('_end') %>
