<%- include('../partials/head') %>
<%- include('_nav') %>
<h1 class="page-title">Заказы</h1>

<nav class="tabs" aria-label="Фильтр по статусу">
  <a href="/admin" <%- !status ? 'aria-current="page"' : '' %>>Все</a>
  <% Object.entries(fmt.ORDER_STATUSES).forEach(([key, label]) => { %>
    <a href="/admin?status=<%= key %>" <%- status === key ? 'aria-current="page"' : '' %>><%= label %> <span class="count"><%= counts[key] %></span></a>
  <% }) %>
</nav>

<% if (list.length === 0) { %>
  <div class="empty"><p class="empty-title">Заказов пока нет</p></div>
<% } else { %>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>№</th><th>Дата</th><th>Клиент</th><th>Телефон</th><th>Получение</th><th class="num">Сумма</th><th>Статус</th></tr></thead>
  <tbody>
    <% list.forEach((o) => { %>
    <tr>
      <td><a href="/admin/orders/<%= o.id %>"><strong><%= o.public_id %></strong></a></td>
      <td><%= dateTime(o.created_at) %></td>
      <td><%= o.customer_name %></td>
      <td><a href="tel:<%= (toTel(o.phone) || o.phone) %>"><%= o.phone %></a></td>
      <td><%= fmt.DELIVERY[o.delivery_method] %></td>
      <td class="num"><%= money(o.total) %></td>
      <td><span class="status status-<%= o.status %>"><%= fmt.ORDER_STATUSES[o.status] %></span></td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>
<%- include('_end') %>
