# Скопируйте этот файл в .env и заполните значения.
# Файл .env в репозиторий не попадает.

# --- Обязательно для боевого запуска (NODE_ENV=production) ---
# Длинная случайная строка, например: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Пароль входа в админ-панель /admin
ADMIN_PASSWORD=

# --- Домен (нужен только для запуска через docker compose) ---
# Домен без https://, например: shop.example.com
DOMAIN=

# --- Основное ---
NODE_ENV=development
PORT=3000
# Адрес сайта без слэша в конце (нужен для sitemap.xml и canonical).
# В боевом режиме укажите https://ваш-домен — тогда cookie помечаются как Secure.
SITE_URL=http://localhost:3000
# Папка для базы данных и загруженных фото. В облаке подключите к ней постоянный диск.
DATA_DIR=./data

# --- Витрина ---
SHOP_NAME=Часовая лавка
SHOP_SLOGAN=Часы, которые хочется носить
SHOP_PHONE=
SHOP_EMAIL=
SHOP_ADDRESS=
SHOP_HOURS=Пн–Сб, 10:00–19:00

# --- Деньги ---
# Код валюты ISO 4217. Украина — UAH (гривна). Один магазин работает в одной валюте.
CURRENCY=UAH
# Часовой пояс, в котором в админ-панели показывается время заказов
TIMEZONE=Europe/Kyiv
# Стоимость доставки курьером и почтой (в целых единицах валюты). Значения примерные — поставьте свои.
DELIVERY_COURIER_FEE=150
DELIVERY_POST_FEE=100
# Бесплатная доставка от этой суммы (0 — отключить)
FREE_DELIVERY_FROM=5000

# --- Демо-данные ---
# При первом запуске с пустой базой создаётся демо-каталог из 12 часов.
# По умолчанию: true на локальном компьютере, false при NODE_ENV=production.
# SEED_DEMO=true
